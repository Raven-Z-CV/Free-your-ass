# Copy to .env to use; .env is excluded by .gitignore and never committed.
# Production tip: put credentials in the env block of your user-level CodeBuddy MCP config instead of .env.

EMAIL_BRIDGE_USER=bridge-xxx@qq.com
EMAIL_BRIDGE_PASS=your-auth-code

# Outbound whitelist: send_email may only send to these addresses (strict single address, comma-separated)
EMAIL_BRIDGE_ALLOWED_TO=you@qq.com
# Inbound whitelist: check_inbox only injects mail from these senders
EMAIL_BRIDGE_ALLOWED_FROM=you@qq.com

# Optional: dual-instance subject prefix (leave empty for single instance)
# EMAIL_BRIDGE_SUBJECT_PREFIX=[FROM-A]

# Optional overrides (hosts are derived from the mailbox domain by default)
# EMAIL_BRIDGE_SMTP_HOST=smtp.qq.com
# EMAIL_BRIDGE_SMTP_PORT=465
# EMAIL_BRIDGE_IMAP_HOST=imap.qq.com
# EMAIL_BRIDGE_IMAP_PORT=993

# Optional: caps and rate limiting
# EMAIL_BRIDGE_MAX_BYTES=8192
# EMAIL_BRIDGE_MAX_MESSAGES=5
# EMAIL_BRIDGE_MAX_PER_HOUR=10

# ---- Model output capture (src/capture/cli.js, optional) ----
# Channel C: node src/capture/cli.js --watch
# Channel A: node src/capture/cli.js --proxy --upstream https://api.openai.com --port 8787
# Event mirror and state live under EMAIL_BRIDGE_LOG_DIR / STATE_DIR by default; --no-email dry-runs without credentials

# Optional: state/log directories (default ~/.local/state/email-bridge/<user>/)
# EMAIL_BRIDGE_STATE_DIR=
# EMAIL_BRIDGE_LOG_DIR=
